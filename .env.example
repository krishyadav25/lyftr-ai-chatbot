# ==============================================================================
# Lyftr AI Chatbot - Environment Configuration Template
# Copy this file to .env and replace placeholder values with actual secrets.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# LLM Gateway: Comma-separated API key pool (at least 2 keys)
# Key IDs are assigned in sequential order: key_1, key_2, ...
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# SQLite Database Location
# In Docker: sqlite:////data/app.db (volume-mounted path)
# Locally: sqlite:///./data/app.db
DATABASE_URL=sqlite:///./data/app.db

# CORS Allowed Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Failure Simulation Hook Switch
# Set to true to honor the X-Simulate-Failure header on POST /chat
ENABLE_FAILURE_SIMULATION=true

# Server Configuration
PORT=8000
HOST=0.0.0.0

# LLM Model Name (used by LiteLLM)
# Examples: gemini/gemini-flash-lite-latest, gemini/gemini-2.0-flash, gpt-4o-mini
LLM_MODEL=gemini/gemini-2.0-flash

# Frontend Environment Configuration
VITE_API_BASE_URL=http://localhost:8000
